---
import Layout from '../layouts/Layout.astro';
import Picture from '../components/Picture.astro';
import Icon from '../components/Icon.astro';
import MapEmbed from '../components/MapEmbed.astro';
import Cta from '../components/Cta.astro';
import { site } from '../data/site';
import { servizi } from '../data/servizi';
import { heroSlides, testimonianze } from '../data/contenuti';
import { heroImgs } from '../data/immagini';

const title = 'Impresa Edile e Noleggio Ponteggi a Ferrara | Slimen Costruzioni';
const description = site.descrizione;
const fotoStudio = heroImgs[1];
---
<Layout title={title} description={description} transparent>
<section class="hero" aria-label="Servizi in evidenza"> <div class="hero-slides" data-hero> {heroSlides.map((s, i) => <figure class:list={['hero-slide', { 'is-active': i === 0 }]} data-title={s.titolo} data-location={s.luogo} data-href={s.href}> <Picture img={s.img} eager={i === 0} class="full-img" /> </figure>)} </div> <div class="container hero-content"> <p class="eyebrow-light mb-3">{site.nome} · {site.attivita} · {site.indirizzo.citta}</p> <h1 class="h1">Il partner ideale per le tue <em>esigenze costruttive</em></h1> <div class="hero-meta"> <div> <p class="lead">Impresa edile e noleggio ponteggi a Ferrara. Trasformiamo le tue visioni in realtà con soluzioni costruttive all’avanguardia e un impegno costante per la soddisfazione del cliente.</p> <div class="btn-row"> <a href="/servizi/" class="btn btn-primary">I nostri servizi</a> <a href="/contatti/#richiesta" class="btn btn-outline-light">Richiedi un preventivo</a> </div> </div> <div class="hero-caption" aria-live="polite"> <span class="label">Nella foto</span> <a href={heroSlides[0].href} class="link-underline" data-hero-caption>{heroSlides[0].titolo} · {heroSlides[0].luogo}</a> <div class="hero-dots" role="group" aria-label="Scegli immagine"> {heroSlides.map((s, i) => <button type="button" aria-label={`Mostra ${s.titolo}`} aria-current={i === 0 ? 'true' : 'false'} data-dot={i}></button>)} </div> </div> </div> </div> </section>

<section class="section"> <div class="container split"> <div class="reveal"> <div class="ratio-45"> <Picture img={fotoStudio} sizes="(min-width: 1024px) 38vw, 92vw" /> </div> </div> <div class="reveal"> <p class="eyebrow mb-2">Chi siamo</p> <h2 class="h2">Impresa edile e noleggio ponteggi a Ferrara</h2> <div class="prose mt-3 lead"> <p>Siamo il partner ideale per le tue esigenze costruttive a Ferrara. Con sede in {site.indirizzo.via}, incarniamo l’eccellenza nel settore edile e trasformiamo le tue visioni in realtà con soluzioni all’avanguardia.</p> <p>Da anni costruiamo un solido rapporto di fiducia con i nostri clienti, offrendo servizi edili innovativi e affidabili grazie a un team di professionisti altamente qualificati.</p> </div> <a href="/studio/" class="btn btn-outline mt-4">Chi siamo</a> </div> </div> </section>

<section class="section bg-sand"> <div class="container"> <div class="section-head reveal"> <div> <p class="eyebrow mb-2">Servizi</p> <h2 class="h2">I nostri servizi edili e di ponteggi</h2> <p class="lead mt-2">Impresa edile, noleggio e allestimento ponteggi a Ferrara.</p> </div> <a href="/servizi/" class="btn btn-outline">Scopri tutti i servizi</a> </div> <ul class="services services-3 reveal"> {servizi.map((s) => <li class="service"> <Icon name={s.icona} class="icon" /> <h3 class="h4"><a href={`/servizi/#${s.id}`} class="link-underline">{s.nome}</a></h3> <p>{s.breve}</p> </li>)} </ul> </div> </section>

<section class="section"> <div class="container"> <div class="section-head reveal"> <div> <p class="eyebrow mb-2">Dicono di noi</p> <h2 class="h2">La parola ai clienti</h2> </div> </div> <div class="grid" style="grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr)); gap: 2rem"> {testimonianze.map((t, i) => <blockquote class="reveal border-top" style={`padding-top:1.5rem; transition-delay:${i * 80}ms`}> <p class="lead" style="font-style:italic">“{t.testo}”</p> <cite class="eyebrow" style="display:block; margin-top:1rem; font-style:normal">— {t.autore}</cite> </blockquote>)} </div> </div> </section>

<section class="section bg-sand"> <div class="container grid-2"> <div class="reveal"> <p class="eyebrow mb-2">Dove siamo</p> <h2 class="h2">{site.nome} a {site.indirizzo.citta}</h2> <p class="lead mt-3">Ci trovi in {site.indirizzo.via} a {site.indirizzo.citta}: scrivici o chiamaci per un sopralluogo e un preventivo gratuito.</p> <div class="contact-cards mt-4"> <div class="contact-card"> <h3>Indirizzo</h3> <p>{site.indirizzo.via}<br>{site.indirizzo.cap} {site.indirizzo.citta} ({site.indirizzo.provincia})</p> <a href={site.mapsUrl} target="_blank" rel="noopener" class="text-link link-underline mt-1" style="display:inline-block">Apri in Google Maps</a> </div> <div class="contact-card"> <h3>Contatti</h3> <p><a href={`tel:${site.telefonoE164}`}>{site.telefono}</a></p> <p><a href={`mailto:${site.email}`}>{site.email}</a></p> </div> </div> </div> <div class="map reveal"> <MapEmbed span={0.012} /> </div> </div> </section>
<Cta />
<script>
var e=document.querySelector(`[data-hero]`);if(e){let t=[...e.querySelectorAll(`.hero-slide`)],n=[...document.querySelectorAll(`[data-dot]`)],r=document.querySelector(`[data-hero-caption]`),i=window.matchMedia(`(prefers-reduced-motion: reduce)`).matches,a=0,o,s=e=>{t[a].classList.remove(`is-active`),n[a].setAttribute(`aria-current`,`false`),a=(e+t.length)%t.length;let i=t[a];i.querySelectorAll(`img`).forEach(e=>e.setAttribute(`loading`,`eager`)),i.classList.add(`is-active`),n[a].setAttribute(`aria-current`,`true`),r&&(r.textContent=`${i.dataset.title} · ${i.dataset.location}`,r.href=i.dataset.href||`#`)},c=()=>{i||(o=window.setInterval(()=>s(a+1),6e3))};n.forEach((e,t)=>e.addEventListener(`click`,()=>{window.clearInterval(o),s(t),c()})),window.addEventListener(`load`,()=>t.forEach(e=>e.querySelectorAll(`img`).forEach(e=>e.setAttribute(`loading`,`eager`)))),c()}
</script>
</Layout>
